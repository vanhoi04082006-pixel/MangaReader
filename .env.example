# ==============================================================
# MangaReader - Personal Manga Reader - Environment Example
# Copy thanh file .env va dien gia tri that. KHONG commit file .env
# ==============================================================

# ---- DATABASE ------------------------------------------------
# Option 1 (default, zero-config): SQLite (dev)
# Duong dan TUONG DOI so voi thu muc prisma/ (chay duoc ca Windows/Linux/macOS)
DATABASE_URL=file:../db/custom.db
# Option 2 (production / Vercel): Supabase Postgres (Session pooler)
# Lay tai: Supabase Dashboard > Project Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1

# ---- SUPABASE AUTH -------------------------------------------
# Lay tai: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
SUPABASE_SERVICE_SECRET_KEY=<sb_secret_...>   # CHI dung phia server, khong expose ra client
# supabase | local (local CHI dung cho dev — production tu choi, fail closed)
AUTH_PROVIDER=supabase

# ---- ADMIN ACCOUNT (single admin) ----------------------------
# Tai khoan duy nhat cua website.
ADMIN_EMAIL=admin@manga.vn
# MAT KHAU BOOTSTRAP (chi dung LAN DAU tao tai khoan trong Supabase Auth).
# Sau bootstrap: doi mat khau tai Supabase Dashboard > Authentication roi
# XOA ADMIN_PASSWORD khoi env production — login/refresh/logout/readiness
# KHONG can bien nay khi tai khoan da ton tai (mat khau do Supabase quan ly).
ADMIN_PASSWORD=<strong-password>
# UUID cua admin trong Supabase Auth (lay tu scripts/bootstrap-admin.ts hoac
# Supabase Dashboard > Authentication > Users).
# BAT BUOC TRONG PRODUCTION: moi API request kiem tra UUID nay — thieu hoac
# mai dinh dang -> TU CHOI HOAN TOAN (fail closed, khong fallback email-only).
# Phai khop admin_user_id trong bang app_config (SQL migration seed san).
ADMIN_USER_ID=<admin-uuid>

# ---- SESSION SIGNING ------------------------------------------
# Tao bang: openssl rand -hex 32  (Windows PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) }))
AUTH_SECRET=<random-64-hex-chars>

# ---- CLOUDFLARE R2 (PRIVATE BUCKET) --------------------------
# Lay tai: Cloudflare Dashboard > R2 > Manage API Tokens / Bucket Settings
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET_NAME=manga-storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Origins duoc phep cho CORS cua bucket (de upload truc tiep browser -> R2).
# Nhiu origin: phan cach bang dau phay. Vi du: http://localhost:3000,https://yourdomain.com
# R2_ALLOWED_ORIGINS=http://localhost:3000

# ---- APPLICATION ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_QUOTA_GB=100
SIGNED_URL_EXPIRY_SECONDS=3600
