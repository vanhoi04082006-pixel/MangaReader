# Caddyfile — chi proxy toi app tren localhost:3000.
# KHONG cho phep XTransformPort (loopback SSRF) — chi dung cho sandbox preview.
# Neu can proxy service noi bo, khai bao ro rang tung port, khong dung wildcard.
:81 {
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}